{
	"layout": "layout.json",
	"knob": {
		"sides": ["left", "right"],
		"row": "number",
		"column": "pinkyOuter"
	},
	"outline": {
		"keycapMarginMm": 1.0,
		"innerCornerRadiusMm": 4.0,
		"outerCornerRadiusMm": 2.0
	},
	"ports": {
		"host": {
			"aimDeg": 45,
			"aimToward": "outer",
			"slope": {
				"from": { "key": "number-ring", "corner": "topOuter" },
				"to": { "key": "number-pinky", "edge": "top" }
			},
			"pushOutMm": 1.5,
			"alongSlope": "centered"
		},
		"link": {
			"aimDeg": 18,
			"aimToward": "outer",
			"slope": {
				"from": { "key": "number-middle", "corner": "topInner" },
				"to": { "key": "number-index", "corner": "topInner" }
			},
			"alongSlope": "squareFarCorner"
		}
	},
	"plug": { "widthMm": 12.4, "clearanceMm": 1.0 },
	"mounting": {
		"at": "keycapJunctionsAndThumb",
		"holeDiameterMm": 2.2,
		"screw": "M2 wafer head",
		"maxHeadHeightMm": 0.8
	},
	"electronics": {
		"fit": "insideOutlineFirst",
		"extendUnder": ["pinkyOuter", "pinky"],
		"extendDownTo": "thumb0"
	}
}
